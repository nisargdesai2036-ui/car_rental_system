# Supabase PostgreSQL Credentials (Replace with your actual values)
SUPABASE_HOST=your-project-id.supabase.co
SUPABASE_PORT=5432
SUPABASE_DATABASE=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your_database_password
SUPABASE_SSL_MODE=Require
SUPABASE_TRUST_SERVER_CERT=true

# Standard ASP.NET Core Connection String
ConnectionStrings__SupabaseConnection=Host=your-project-id.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=your_database_password;SSL Mode=Require;Trust Server Certificate=true;
