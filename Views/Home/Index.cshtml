@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center py-5">
    <h1 class="display-4">Welcome</h1>
    <p class="lead">Welcome to DriveEase Car Rental System.</p>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    <div class="mt-4">
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary" asp-controller="Account" asp-action="Profile">Go to My Profile</a>
        }
        else
        {
            <a class="btn btn-primary me-2" asp-controller="Account" asp-action="Login">Sign In</a>
            <a class="btn btn-outline-secondary" asp-controller="Account" asp-action="Register">Register</a>
        }
    </div>
</div>
