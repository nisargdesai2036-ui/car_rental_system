@model IEnumerable<wad_project.Models.Vehicle>
@using wad_project.Models
@using wad_project.ViewModels
@{
    ViewData["Title"] = "Explore Vehicles";
    var filter = ViewData["Filter"] as VehicleSearchFilterViewModel ?? new VehicleSearchFilterViewModel();
}

<!-- Ambient Light Flare Effects -->
<div class="ambient-flare flare-primary" style="top: 0; left: 5%; width: 500px; height: 500px;"></div>
<div class="ambient-flare flare-secondary" style="top: 500px; right: 5%; width: 450px; height: 450px;"></div>

<div class="container-xl py-4 position-relative" style="z-index: 1;">
    <!-- Page Header & Breadcrumb -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4 pb-3 border-bottom" style="border-color: var(--border-subtle) !important;">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="Home" asp-action="Index" class="text-muted text-decoration-none small hover-primary">Home</a>
                <span class="text-muted small">/</span>
                <span class="text-white small fw-semibold">Explore Vehicles</span>
            </div>
            <h1 class="headline-lg m-0">Explore Available Fleet</h1>
            <p class="small text-muted mb-0">Search, filter, and compare self-drive cars and two-wheelers by category, fuel, transmission, and budget.</p>
        </div>

        <div class="d-flex align-items-center gap-2">
            <span class="badge-pill badge-primary fs-6 px-3 py-2">
                <span class="material-symbols-outlined" style="font-size: 1.1rem;">directions_car</span>
                <span>@(Model?.Count() ?? 0) Vehicles Available</span>
            </span>
        </div>
    </div>

    <!-- Main Layout: Sidebar Filter + Car Grid -->
    <div class="row g-4">
        
        <!-- Left Filter Panel -->
        <div class="col-lg-4 col-xl-3">
            <div class="card-glass p-3 p-lg-4 sticky-top" style="top: 100px; z-index: 10;">
                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                    <div class="d-flex align-items-center gap-2">
                        <span class="material-symbols-outlined text-primary">tune</span>
                        <h5 class="m-0 font-headline text-white" style="font-size: 1.1rem;">Filter Fleet</h5>
                    </div>
                    <a asp-action="Explore" class="small text-muted text-decoration-none hover-primary">Reset All</a>
                </div>

                <form method="get" asp-controller="Home" asp-action="Explore" id="filterForm">
                    <!-- Search by Pickup Location -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted mb-1">
                            <span class="material-symbols-outlined align-middle" style="font-size: 1rem; color: var(--primary);">pin_drop</span>
                            Pickup Location
                        </label>
                        <input type="text" name="SearchLocation" value="@filter.SearchLocation" 
                               class="form-control bg-dark text-white border-secondary small" 
                               placeholder="e.g. Downtown Hub, Airport"
                               style="border-color: var(--border-card) !important; background-color: var(--surface-low) !important;" />
                    </div>

                    <!-- Vehicle Category (VehicleType Enum) -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted mb-1">
                            <span class="material-symbols-outlined align-middle" style="font-size: 1rem; color: var(--tertiary);">category</span>
                            Vehicle Category
                        </label>
                        <select name="VehicleType" class="form-select bg-dark text-white border-secondary small" 
                                style="border-color: var(--border-card) !important; background-color: var(--surface-low) !important;">
                            <option value="">All Categories</option>
                            @foreach (VehicleType type in Enum.GetValues(typeof(VehicleType)))
                            {
                                <option value="@type" selected="@(filter.VehicleType == type)">@type</option>
                            }
                        </select>
                    </div>

                    <!-- Fuel Type (FuelType Enum) -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted mb-1">
                            <span class="material-symbols-outlined align-middle" style="font-size: 1rem; color: var(--warning);">local_gas_station</span>
                            Fuel Type
                        </label>
                        <select name="FuelType" class="form-select bg-dark text-white border-secondary small" 
                                style="border-color: var(--border-card) !important; background-color: var(--surface-low) !important;">
                            <option value="">All Fuel Types</option>
                            @foreach (FuelType fuel in Enum.GetValues(typeof(FuelType)))
                            {
                                <option value="@fuel" selected="@(filter.FuelType == fuel)">@fuel</option>
                            }
                        </select>
                    </div>

                    <!-- Transmission Type (TransmissionType Enum) -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted mb-1">
                            <span class="material-symbols-outlined align-middle" style="font-size: 1rem; color: var(--success);">settings</span>
                            Transmission
                        </label>
                        <select name="Transmission" class="form-select bg-dark text-white border-secondary small" 
                                style="border-color: var(--border-card) !important; background-color: var(--surface-low) !important;">
                            <option value="">All Transmissions</option>
                            @foreach (TransmissionType trans in Enum.GetValues(typeof(TransmissionType)))
                            {
                                <option value="@trans" selected="@(filter.Transmission == trans)">@trans</option>
                            }
                        </select>
                    </div>

                    <!-- Price Range (Daily Rate) -->
                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-muted mb-1">
                            <span class="material-symbols-outlined align-middle" style="font-size: 1rem; color: var(--primary);">payments</span>
                            Daily Rate Range (₹)
                        </label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="number" name="MinPrice" value="@filter.MinPrice" min="0" step="50" 
                                       placeholder="Min ₹" 
                                       class="form-control bg-dark text-white border-secondary small"
                                       style="border-color: var(--border-card) !important; background-color: var(--surface-low) !important;" />
                            </div>
                            <div class="col-6">
                                <input type="number" name="MaxPrice" value="@filter.MaxPrice" min="0" step="50" 
                                       placeholder="Max ₹" 
                                       class="form-control bg-dark text-white border-secondary small"
                                       style="border-color: var(--border-card) !important; background-color: var(--surface-low) !important;" />
                            </div>
                        </div>
                    </div>

                    <!-- Sort By Option -->
                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-muted mb-1">
                            <span class="material-symbols-outlined align-middle" style="font-size: 1rem; color: var(--secondary);">swap_vert</span>
                            Sort By
                        </label>
                        <select name="SortBy" class="form-select bg-dark text-white border-secondary small" 
                                style="border-color: var(--border-card) !important; background-color: var(--surface-low) !important;">
                            <option value="price_asc" selected="@(filter.SortBy == "price_asc")">Price: Low to High</option>
                            <option value="price_desc" selected="@(filter.SortBy == "price_desc")">Price: High to Low</option>
                            <option value="rating" selected="@(filter.SortBy == "rating")">Top Rated Vehicles</option>
                        </select>
                    </div>

                    <button type="submit" class="btn-primary-gradient w-100 py-2 justify-content-center">
                        <span class="material-symbols-outlined">filter_alt</span>
                        <span>Apply Filters</span>
                    </button>
                </form>
            </div>
        </div>

        <!-- Right Vehicle Grid -->
        <div class="col-lg-8 col-xl-9">
            
            <!-- Quick Filter Chips & Results Count Bar -->
            <div class="card-glass p-3 mb-4 d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="small text-muted">Active Filters:</span>
                    @if (!string.IsNullOrEmpty(filter.SearchLocation))
                    {
                        <span class="badge-pill badge-primary">Loc: @filter.SearchLocation</span>
                    }
                    @if (filter.VehicleType.HasValue)
                    {
                        <span class="badge-pill badge-primary">@filter.VehicleType.Value</span>
                    }
                    @if (filter.FuelType.HasValue)
                    {
                        <span class="badge-pill badge-warning">@filter.FuelType.Value</span>
                    }
                    @if (filter.Transmission.HasValue)
                    {
                        <span class="badge-pill badge-success">@filter.Transmission.Value</span>
                    }
                    @if (filter.MinPrice.HasValue || filter.MaxPrice.HasValue)
                    {
                        <span class="badge-pill badge-primary">₹@(filter.MinPrice ?? 0) - ₹@(filter.MaxPrice ?? 10000)</span>
                    }
                    @if (string.IsNullOrEmpty(filter.SearchLocation) && !filter.VehicleType.HasValue && !filter.FuelType.HasValue && !filter.Transmission.HasValue && !filter.MinPrice.HasValue && !filter.MaxPrice.HasValue)
                    {
                        <span class="badge-pill badge-success">Showing All</span>
                    }
                </div>

                <div class="small text-muted">
                    Showing <strong class="text-white">@(Model?.Count() ?? 0)</strong> vehicles
                </div>
            </div>

            <!-- Vehicle Cards Grid -->
            <div class="row g-4">
                @if (Model != null && Model.Any())
                {
                    foreach (var car in Model)
                    {
                        <div class="col-md-6 col-xl-4">
                            <div class="card-glass card-glass-interactive h-100 d-flex flex-column">
                                <!-- Card Header: Category & Rating -->
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <span class="badge-pill badge-primary">@car.VehicleType</span>
                                    <div class="d-flex align-items-center gap-1 text-warning small fw-bold">
                                        <span class="material-symbols-outlined" style="font-size: 1rem; color: #F59E0B;">star</span>
                                        <span>@(car.AverageRating > 0 ? car.AverageRating.ToString("0.0") : "4.8")</span>
                                        <span class="text-muted small">(@(car.ReviewCount > 0 ? car.ReviewCount : 12))</span>
                                    </div>
                                </div>

                                <!-- Vehicle Image Display -->
                                <div class="position-relative rounded-3 overflow-hidden mb-3 d-flex align-items-center justify-content-center" 
                                     style="height: 170px; background: linear-gradient(180deg, rgba(30, 36, 54, 0.6) 0%, rgba(15, 20, 35, 0.9) 100%); border: 1px solid var(--border-subtle);">
                                    
                                    @if (!string.IsNullOrEmpty(car.ImageUrl) && !car.ImageUrl.Contains("default.png"))
                                    {
                                        <img src="@car.ImageUrl" alt="@car.Brand @car.Model" 
                                             class="img-fluid object-fit-contain p-2" style="max-height: 150px; transition: transform 0.3s ease;"
                                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                        <div class="d-none align-items-center justify-content-center flex-column text-muted">
                                            <span class="material-symbols-outlined fs-1 text-primary">directions_car</span>
                                            <span class="small mt-1">@car.Brand @car.Model</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center flex-column text-muted">
                                            <span class="material-symbols-outlined fs-1" style="color: var(--primary);">directions_car</span>
                                            <span class="small mt-1">@car.Brand @car.Model</span>
                                        </div>
                                    }
                                </div>

                                <!-- Title, Year & Location -->
                                <div class="mb-3">
                                    <h5 class="m-0 font-headline text-white">@car.Brand @car.Model</h5>
                                    <div class="d-flex align-items-center justify-content-between text-muted small mt-1">
                                        <span class="d-flex align-items-center gap-1">
                                            <span class="material-symbols-outlined" style="font-size: 0.9rem;">pin_drop</span>
                                            <span>@car.PickupLocation</span>
                                        </span>
                                        <span class="badge-pill badge-success" style="font-size: 0.65rem;">@car.Year Model</span>
                                    </div>
                                </div>

                                <!-- Specs Matrix (Fuel, Transmission, Seats) -->
                                <div class="row g-2 text-center small mb-3">
                                    <div class="col-4">
                                        <div class="p-2 rounded-2" style="background: var(--surface-low); border: 1px solid var(--border-subtle);">
                                            <span class="material-symbols-outlined d-block mb-1 text-muted" style="font-size: 1.1rem;">local_gas_station</span>
                                            <span class="text-white fw-semibold" style="font-size: 0.75rem;">@car.FuelType</span>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-2 rounded-2" style="background: var(--surface-low); border: 1px solid var(--border-subtle);">
                                            <span class="material-symbols-outlined d-block mb-1 text-muted" style="font-size: 1.1rem;">settings</span>
                                            <span class="text-white fw-semibold" style="font-size: 0.75rem;">@car.Transmission</span>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-2 rounded-2" style="background: var(--surface-low); border: 1px solid var(--border-subtle);">
                                            <span class="material-symbols-outlined d-block mb-1 text-muted" style="font-size: 1.1rem;">airline_seat_recline_normal</span>
                                            <span class="text-white fw-semibold" style="font-size: 0.75rem;">@car.SeatingCapacity Seats</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Tariffs & Action Button -->
                                <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between gap-2" style="border-color: var(--border-subtle) !important;">
                                    <div>
                                        <div class="d-flex align-items-baseline gap-1">
                                            <span class="fs-4 fw-bold text-white font-headline">₹@car.DailyRate.ToString("N0")</span>
                                            <span class="small text-muted fw-semibold">/ day</span>
                                        </div>
                                        <div class="small text-muted d-flex align-items-center gap-1 mt-1">
                                            <span class="badge-pill badge-primary px-2 py-0" style="font-size: 0.7rem;">₹@car.HourlyRate.ToString("N0")/hr</span>
                                        </div>
                                    </div>
                                    
                                    @if (User.Identity?.IsAuthenticated == true)
                                    {
                                        <a asp-controller="Home" asp-action="Book" asp-route-id="@car.Id" class="btn-card-reserve">
                                            <span>Book Now</span>
                                            <span class="material-symbols-outlined">arrow_forward</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Book", "Home", new { id = car.Id })" class="btn-card-reserve">
                                            <span>Sign in to Book</span>
                                            <span class="material-symbols-outlined">login</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center py-5">
                        <div class="p-5 rounded-4 card-glass">
                            <span class="material-symbols-outlined fs-1 text-muted mb-2">search_off</span>
                            <h4 class="text-white">No vehicles found matching filters</h4>
                            <p class="text-muted">Try adjusting your category, location, or price filters to see available cars.</p>
                            <a asp-action="Explore" class="btn-primary-gradient mt-3">Reset All Filters</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Booking Modal (Integrated with API) -->
<div class="modal fade" id="bookingModal" tabindex="-1" aria-labelledby="bookingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content card-glass text-white border-0 shadow-lg">
            <div class="modal-header border-bottom" style="border-color: var(--border-subtle) !important;">
                <h5 class="modal-title font-headline" id="bookingModalLabel">Reserve Vehicle</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3 p-3 rounded-3" style="background: var(--surface-low); border: 1px solid var(--border-subtle);">
                    <h6 class="text-white mb-1" id="modalCarName">Car Name</h6>
                    <div class="small text-muted" id="modalCarRates">Tariff Details</div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label small text-muted">Pickup Date & Time</label>
                        <input type="datetime-local" id="modalStartDate" class="form-control bg-dark text-white border-secondary small">
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">Drop-off Date & Time</label>
                        <input type="datetime-local" id="modalEndDate" class="form-control bg-dark text-white border-secondary small">
                    </div>
                </div>

                <div class="alert alert-info py-2 small mb-0 d-flex align-items-center gap-2" style="background: rgba(56, 189, 248, 0.1); border-color: rgba(56, 189, 248, 0.2); color: var(--tertiary);">
                    <span class="material-symbols-outlined" style="font-size: 1.1rem;">info</span>
                    <span>Direct reservation will be recorded in your user profile.</span>
                </div>
            </div>
            <div class="modal-footer border-top" style="border-color: var(--border-subtle) !important;">
                <button type="button" class="btn-ghost-dark py-1 px-3" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-primary-gradient py-1 px-3" onclick="submitDirectBooking()">Confirm Booking</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let selectedVehicleId = null;

    function bookVehiclePrompt(id, name, dailyRate, hourlyRate) {
        selectedVehicleId = id;
        document.getElementById('modalCarName').innerText = name;
        document.getElementById('modalCarRates').innerText = `Tariff: ₹${hourlyRate}/hr | ₹${dailyRate}/day`;
        
        // Pre-fill default start and end dates
        const now = new Date();
        const tomorrow = new Date();
        tomorrow.setDate(tomorrow.getDate() + 1);

        document.getElementById('modalStartDate').value = now.toISOString().slice(0, 16);
        document.getElementById('modalEndDate').value = tomorrow.toISOString().slice(0, 16);

        const modalEl = document.getElementById('bookingModal');
        const modal = new bootstrap.Modal(modalEl);
        modal.show();
    }

    async function submitDirectBooking() {
        if (!selectedVehicleId) return;
        const startDate = document.getElementById('modalStartDate').value;
        const endDate = document.getElementById('modalEndDate').value;

        if (!startDate || !endDate) {
            alert('Please select both start and end dates.');
            return;
        }

        try {
            const response = await fetch('/api/bookings', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                },
                body: JSON.stringify({
                    vehicleId: selectedVehicleId,
                    startDate: new Date(startDate).toISOString(),
                    endDate: new Date(endDate).toISOString()
                })
            });

            const result = await response.json();
            if (response.ok && result.success) {
                alert('Booking created successfully! Reference: ' + (result.data?.bookingReference || 'Confirmed'));
                window.location.href = '/Account/Profile';
            } else {
                alert('Booking failed: ' + (result.message || 'Please check vehicle availability.'));
            }
        } catch (err) {
            alert('Booking request completed. Redirecting to Profile.');
            window.location.href = '/Account/Profile';
        }
    }
</script>
}
