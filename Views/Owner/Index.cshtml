@model wad_project.ViewModels.OwnerDashboardViewModel
@{
    ViewData["Title"] = "Fleet Owner Portal";
}

<div class="container-fluid px-3 px-lg-5 py-4">
    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success bg-dark text-success border border-success rounded-4 d-flex align-items-center gap-3 p-3 mb-4 shadow-lg" role="alert">
            <span class="material-symbols-outlined fs-4 text-success">check_circle</span>
            <div class="flex-grow-1 fw-medium text-white">@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger bg-dark text-danger border border-danger rounded-4 d-flex align-items-center gap-3 p-3 mb-4 shadow-lg" role="alert">
            <span class="material-symbols-outlined fs-4 text-danger">error</span>
            <div class="flex-grow-1 fw-medium text-white">@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header & Action -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom" style="border-color: rgba(255, 255, 255, 0.1) !important;">
        <div>
            <h1 class="h3 fw-bold text-white mb-1" style="font-family: 'Plus Jakarta Sans', sans-serif;">
                Fleet Owner Portal
            </h1>
            <p class="text-light opacity-75 mb-0">Manage vehicle availability and monitor customer trip income</p>
        </div>

        <button type="button" class="btn-primary-gradient py-2 px-3" data-bs-toggle="modal" data-bs-target="#addVehicleModal">
            <span class="material-symbols-outlined">add_circle</span>
            <span>List New Vehicle</span>
        </button>
    </div>

    <!-- Owner Stats Row -->
    <div class="row g-3 mb-4">
        <!-- Total Income -->
        <div class="col-6 col-lg-3">
            <div class="glass-card p-3 rounded-4 h-100" style="background: rgba(22, 27, 42, 0.95); border: 1px solid rgba(255, 255, 255, 0.12);">
                <div class="small text-light opacity-75 fw-semibold mb-1">Total Earnings</div>
                <div class="h2 fw-bold text-success mb-0">$@Model.TotalEarnings.ToString("N2")</div>
                <div class="small text-light opacity-75 mt-1">@Model.TotalBookings trip(s) recorded</div>
            </div>
        </div>

        <!-- Total Vehicles -->
        <div class="col-6 col-lg-3">
            <div class="glass-card p-3 rounded-4 h-100" style="background: rgba(22, 27, 42, 0.95); border: 1px solid rgba(255, 255, 255, 0.12);">
                <div class="small text-light opacity-75 fw-semibold mb-1">My Vehicles</div>
                <div class="h2 fw-bold text-white mb-0">@Model.TotalVehicles</div>
                <div class="small text-light opacity-75 mt-1">
                    <span class="text-success fw-semibold">@Model.ApprovedVehicles approved</span>, 
                    <span class="text-warning fw-semibold">@Model.PendingVehicles pending</span>
                </div>
            </div>
        </div>

        <!-- Booked Cars -->
        <div class="col-6 col-lg-3">
            <div class="glass-card p-3 rounded-4 h-100" style="background: rgba(22, 27, 42, 0.95); border: 1px solid rgba(255, 255, 255, 0.12);">
                <div class="small text-light opacity-75 fw-semibold mb-1">Vehicles on Trip</div>
                <div class="h2 fw-bold text-primary mb-0">@Model.BookedVehicles</div>
                <div class="small text-light opacity-75 mt-1">Currently rented out</div>
            </div>
        </div>

        <!-- Active Bookings -->
        <div class="col-6 col-lg-3">
            <div class="glass-card p-3 rounded-4 h-100" style="background: rgba(22, 27, 42, 0.95); border: 1px solid rgba(255, 255, 255, 0.12);">
                <div class="small text-light opacity-75 fw-semibold mb-1">Active Bookings</div>
                <div class="h2 fw-bold text-white mb-0">@Model.ActiveBookings</div>
                <div class="small text-light opacity-75 mt-1">Confirmed & pending trips</div>
            </div>
        </div>
    </div>

    <!-- Section 1: My Vehicles -->
    <div class="glass-card p-4 rounded-4 mb-4" style="background: rgba(22, 27, 42, 0.95); border: 1px solid rgba(255, 255, 255, 0.12);">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="h5 fw-bold text-white mb-1">My Fleet</h3>
                <p class="small text-light opacity-75 mb-0">Control vehicle availability (Available, Maintenance, Deactivate)</p>
            </div>
            <button type="button" class="btn-ghost-dark py-1 px-3 small text-white" data-bs-toggle="modal" data-bs-target="#addVehicleModal">
                + Add Car
            </button>
        </div>

        @if (!Model.MyVehicles.Any())
        {
            <div class="text-center py-5">
                <span class="material-symbols-outlined display-4 text-light opacity-50 mb-2">directions_car</span>
                <h4 class="h6 text-white">No vehicles listed yet</h4>
                <p class="small text-light opacity-75">Start earning by listing your car or bike on DriveEase.</p>
                <button type="button" class="btn-primary-gradient py-2 px-4 mt-2" data-bs-toggle="modal" data-bs-target="#addVehicleModal">
                    List Your First Car
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                    <thead>
                        <tr class="small text-uppercase tracking-wider border-bottom" style="color: #CBD5E1; border-color: rgba(255, 255, 255, 0.1) !important;">
                            <th>Vehicle</th>
                            <th>Plate</th>
                            <th>Rental Rates</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th class="text-end">Controls</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var car in Model.MyVehicles)
                        {
                            <tr style="border-color: rgba(255, 255, 255, 0.08) !important;">
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@car.ImageUrl" alt="@car.Brand @car.Model" class="rounded-3 object-fit-cover" style="width: 56px; height: 38px; background: #0A0F1D;" onerror="this.src='https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=400&q=80';" />
                                        <div>
                                            <div class="fw-bold text-white">@car.Brand @car.Model (@car.Year)</div>
                                            <div class="small text-light opacity-75">@car.VehicleType • @car.Transmission</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="font-monospace fw-bold text-white px-2 py-1 rounded" style="background: #090E1C; border: 1px solid rgba(255, 255, 255, 0.15);">
                                        @car.LicensePlate
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-white">$@car.DailyRate<span class="text-light opacity-75 small">/day</span></div>
                                    <div class="small text-light opacity-75">$@car.HourlyRate/hr</div>
                                </td>
                                <td class="small text-white">@car.PickupLocation</td>
                                <td>
                                    @if (car.Status == wad_project.Models.VehicleStatus.Approved || car.Status == wad_project.Models.VehicleStatus.Available)
                                    {
                                        <span class="badge rounded-pill px-2 py-1 text-xs fw-bold" style="background: rgba(16, 185, 129, 0.2); color: #34D399; border: 1px solid rgba(16, 185, 129, 0.4);">
                                            Available
                                        </span>
                                    }
                                    else if (car.Status == wad_project.Models.VehicleStatus.Booked)
                                    {
                                        <span class="badge rounded-pill px-2 py-1 text-xs fw-bold" style="background: rgba(99, 102, 241, 0.2); color: #818CF8; border: 1px solid rgba(99, 102, 241, 0.4);">
                                            Booked
                                        </span>
                                    }
                                    else if (car.Status == wad_project.Models.VehicleStatus.UnderMaintenance)
                                    {
                                        <span class="badge rounded-pill px-2 py-1 text-xs fw-bold" style="background: rgba(245, 158, 11, 0.2); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.4);">
                                            Maintenance
                                        </span>
                                    }
                                    else if (car.Status == wad_project.Models.VehicleStatus.Pending)
                                    {
                                        <span class="badge rounded-pill px-2 py-1 text-xs fw-bold" style="background: rgba(239, 68, 68, 0.2); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.4);">
                                            Pending Review
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill px-2 py-1 text-xs text-light opacity-75" style="background: rgba(255, 255, 255, 0.1);">
                                            Deactivated
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (car.Status == wad_project.Models.VehicleStatus.Pending)
                                    {
                                        <span class="text-light opacity-75 small">Awaiting Review</span>
                                    }
                                    else
                                    {
                                        <div class="d-inline-flex gap-1">
                                            @if (car.Status != wad_project.Models.VehicleStatus.Available)
                                            {
                                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@car.Id" />
                                                    <input type="hidden" name="status" value="@wad_project.Models.VehicleStatus.Available" />
                                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-2 py-1 text-xs">
                                                        Available
                                                    </button>
                                                </form>
                                            }

                                            @if (car.Status != wad_project.Models.VehicleStatus.UnderMaintenance)
                                            {
                                                <form asp-action="UpdateStatus" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@car.Id" />
                                                    <input type="hidden" name="status" value="@wad_project.Models.VehicleStatus.UnderMaintenance" />
                                                    <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-2 py-1 text-xs">
                                                        Maintenance
                                                    </button>
                                                </form>
                                            }

                                            @if (car.Status != wad_project.Models.VehicleStatus.Inactive)
                                            {
                                                <form asp-action="DeleteVehicle" method="post" class="d-inline" onsubmit="return confirm('Deactivate @car.Brand @car.Model?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@car.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-2 py-1 text-xs">
                                                        Deactivate
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Section 2: Bookings on My Vehicles -->
    <div class="glass-card p-4 rounded-4" style="background: rgba(22, 27, 42, 0.95); border: 1px solid rgba(255, 255, 255, 0.12);">
        <div class="mb-3">
            <h3 class="h5 fw-bold text-white mb-1">Customer Bookings & Income</h3>
            <p class="small text-light opacity-75 mb-0">Customer reservations on your listed vehicles</p>
        </div>

        @if (!Model.MyVehicleBookings.Any())
        {
            <div class="text-center py-4 text-light opacity-75 small">
                No customer bookings recorded on your vehicles yet.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0" style="background: transparent;">
                    <thead>
                        <tr class="small text-uppercase tracking-wider border-bottom" style="color: #CBD5E1; border-color: rgba(255, 255, 255, 0.1) !important;">
                            <th>Reference</th>
                            <th>Vehicle</th>
                            <th>Customer</th>
                            <th>Dates</th>
                            <th>Earnings</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in Model.MyVehicleBookings)
                        {
                            <tr style="border-color: rgba(255, 255, 255, 0.08) !important;">
                                <td class="fw-bold text-white font-monospace">#@b.BookingReference</td>
                                <td>
                                    <div class="fw-semibold text-white">@(b.Vehicle != null ? $"{b.Vehicle.Brand} {b.Vehicle.Model}" : "Car")</div>
                                    <div class="small text-light opacity-75 font-monospace">@(b.Vehicle?.LicensePlate ?? "-")</div>
                                </td>
                                <td>
                                    <div class="text-white">@(b.User?.FullName ?? "Customer")</div>
                                    <div class="small text-light opacity-75">@(b.User?.Email ?? "-")</div>
                                </td>
                                <td class="small text-white">
                                    <div>@b.PickupDateTime.ToString("MMM dd HH:mm") &rarr; @b.ReturnDateTime.ToString("MMM dd HH:mm")</div>
                                    <div class="text-light opacity-75">@b.RentalDuration @(b.RentalType == wad_project.Models.RentalType.Hourly ? "Hours" : "Days")</div>
                                </td>
                                <td>
                                    <div class="fw-bold text-success">$@b.TotalAmount.ToString("N2")</div>
                                </td>
                                <td>
                                    @if (b.Status == wad_project.Models.BookingStatus.Confirmed)
                                    {
                                        <span class="badge rounded-pill px-2 py-1 text-xs fw-bold" style="background: rgba(16, 185, 129, 0.2); color: #34D399; border: 1px solid rgba(16, 185, 129, 0.4);">Confirmed</span>
                                    }
                                    else if (b.Status == wad_project.Models.BookingStatus.Completed)
                                    {
                                        <span class="badge rounded-pill px-2 py-1 text-xs fw-bold" style="background: rgba(99, 102, 241, 0.2); color: #818CF8; border: 1px solid rgba(99, 102, 241, 0.4);">Completed</span>
                                    }
                                    else if (b.Status == wad_project.Models.BookingStatus.Cancelled)
                                    {
                                        <span class="badge rounded-pill px-2 py-1 text-xs fw-bold" style="background: rgba(239, 68, 68, 0.2); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.4);">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill px-2 py-1 text-xs fw-bold" style="background: rgba(245, 158, 11, 0.2); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.4);">Pending</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal: List New Vehicle -->
<div class="modal fade" id="addVehicleModal" tabindex="-1" aria-labelledby="addVehicleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content text-white rounded-4 border-0 shadow-2xl" style="background: #1A1F2E; border: 1px solid rgba(255, 255, 255, 0.15) !important;">
            <div class="modal-header border-bottom p-4" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                <div>
                    <h5 class="modal-title fw-bold text-white mb-0" id="addVehicleModalLabel" style="font-family: 'Plus Jakarta Sans', sans-serif;">
                        List Your Vehicle
                    </h5>
                    <p class="small text-light opacity-75 mb-0">Submit your vehicle to the DriveEase fleet for admin review</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="AddVehicle" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-12 col-md-6">
                            <label class="form-label text-light small fw-semibold">Brand / Make *</label>
                            <input asp-for="NewVehicle.Brand" class="form-control form-control-dark rounded-3 text-white" placeholder="e.g. Toyota, Honda, Hyundai, BMW" required />
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="form-label text-light small fw-semibold">Model Name *</label>
                            <input asp-for="NewVehicle.Model" class="form-control form-control-dark rounded-3 text-white" placeholder="e.g. Camry, Civic, Creta, 3 Series" required />
                        </div>

                        <div class="col-6 col-md-4">
                            <label class="form-label text-light small fw-semibold">Year *</label>
                            <input asp-for="NewVehicle.Year" class="form-control form-control-dark rounded-3 text-white" type="number" min="2010" max="2030" required />
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label text-light small fw-semibold">License Plate *</label>
                            <input asp-for="NewVehicle.LicensePlate" class="form-control form-control-dark rounded-3 text-uppercase font-monospace text-white" placeholder="e.g. DL-01-AB-1234" required />
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-light small fw-semibold">Vehicle Category</label>
                            <select asp-for="NewVehicle.VehicleType" class="form-select form-control-dark rounded-3 text-white" asp-items="Html.GetEnumSelectList<wad_project.Models.VehicleType>()"></select>
                        </div>

                        <div class="col-6 col-md-4">
                            <label class="form-label text-light small fw-semibold">Transmission</label>
                            <select asp-for="NewVehicle.Transmission" class="form-select form-control-dark rounded-3 text-white" asp-items="Html.GetEnumSelectList<wad_project.Models.TransmissionType>()"></select>
                        </div>
                        <div class="col-6 col-md-4">
                            <label class="form-label text-light small fw-semibold">Fuel Type</label>
                            <select asp-for="NewVehicle.FuelType" class="form-select form-control-dark rounded-3 text-white" asp-items="Html.GetEnumSelectList<wad_project.Models.FuelType>()"></select>
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label text-light small fw-semibold">Seating Capacity</label>
                            <input asp-for="NewVehicle.SeatingCapacity" class="form-control form-control-dark rounded-3 text-white" type="number" min="1" max="12" />
                        </div>

                        <div class="col-6">
                            <label class="form-label text-light small fw-semibold">Hourly Rate ($) *</label>
                            <input asp-for="NewVehicle.HourlyRate" class="form-control form-control-dark rounded-3 text-white" type="number" step="0.01" min="1" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label text-light small fw-semibold">Daily Rate ($) *</label>
                            <input asp-for="NewVehicle.DailyRate" class="form-control form-control-dark rounded-3 text-white" type="number" step="0.01" min="1" required />
                        </div>

                        <div class="col-12">
                            <label class="form-label text-light small fw-semibold">Pickup Location *</label>
                            <input asp-for="NewVehicle.PickupLocation" class="form-control form-control-dark rounded-3 text-white" placeholder="e.g. Downtown Hub, Airport Terminal 2" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label text-light small fw-semibold">Image URL (Optional)</label>
                            <input asp-for="NewVehicle.ImageUrl" class="form-control form-control-dark rounded-3 text-white" placeholder="https://... (Leave blank for default photo)" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-top p-3" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                    <button type="button" class="btn btn-ghost-dark py-2 px-3 rounded-pill text-white" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-primary-gradient py-2 px-4">
                        <span class="material-symbols-outlined">send</span>
                        <span>Submit for Admin Approval</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
