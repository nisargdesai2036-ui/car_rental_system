@model wad_project.ViewModels.UserProfileViewModel
@using wad_project.Models
@{
    ViewData["Title"] = "My Profile";
}

<!-- Ambient Lighting Canvas Flares -->
<div class="ambient-flare flare-primary" style="top: 10%; left: 25%; width: 500px; height: 500px;"></div>
<div class="ambient-flare flare-secondary" style="bottom: 10%; right: 20%; width: 450px; height: 450px;"></div>

<div class="container-xl py-5 position-relative" style="z-index: 10;">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8 col-sm-11">
            <div class="card-glass p-4 p-sm-5 position-relative overflow-hidden shadow-2xl" 
                 style="border-radius: var(--radius-3xl); background: linear-gradient(135deg, rgba(22, 27, 42, 0.95) 0%, rgba(37, 42, 57, 0.60) 100%); border: 1px solid var(--border-card);">
                
                <!-- Background Grid Lighting Accent -->
                <div class="position-absolute top-0 start-0 w-100 h-100" style="background-image: radial-gradient(rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 20px 20px; pointer-events: none;"></div>

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success py-2 px-3 small mb-4 d-flex align-items-center gap-2 position-relative" style="z-index: 5; background: rgba(16, 185, 129, 0.15); border-color: rgba(16, 185, 129, 0.35); color: #10B981;">
                        <span class="material-symbols-outlined">check_circle</span>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger py-2 px-3 small mb-4 d-flex align-items-center gap-2 position-relative" style="z-index: 5; background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.35); color: #FFB4AB;">
                        <span class="material-symbols-outlined">error</span>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                }

                <!-- Profile Header & Avatar -->
                <div class="d-flex align-items-center gap-4 mb-4 position-relative" style="z-index: 2;">
                    <div class="position-relative">
                        <div class="avatar-placeholder" style="width: 72px; height: 72px; font-size: 1.75rem; border-radius: 50%; box-shadow: var(--shadow-glow);">
                            @(Model.FullName.Length > 0 ? Model.FullName[0].ToString().ToUpper() : "U")
                        </div>
                        <span class="position-absolute bottom-0 end-0 p-1 bg-success border border-2 border-dark rounded-circle" style="width: 16px; height: 16px;"></span>
                    </div>

                    <div class="flex-grow-1">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <h2 class="headline-md text-white mb-0">@Model.FullName</h2>
                            <span class="badge-pill badge-primary">@Model.Role</span>
                        </div>
                        <div class="text-muted small">@Model.Email</div>
                        <div class="label-sm mt-1" style="color: var(--tertiary);">Member since @Model.CreatedAt.ToString("MMMM yyyy")</div>
                    </div>
                </div>

                <!-- User Details Grid -->
                <div class="row g-3 my-2 position-relative" style="z-index: 2;">
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3" style="background: var(--surface-low); border: 1px solid var(--border-subtle);">
                            <span class="label-sm text-muted d-block text-uppercase mb-1">Mobile Number</span>
                            <div class="fw-semibold text-white d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined" style="font-size: 1.1rem; color: var(--primary);">phone</span>
                                <span>@Model.MobileNumber</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6">
                        <div class="p-3 rounded-3" style="background: var(--surface-low); border: 1px solid var(--border-subtle);">
                            <span class="label-sm text-muted d-block text-uppercase mb-1">Driving License</span>
                            <div class="fw-semibold text-white d-flex align-items-center gap-2">
                                <span class="material-symbols-outlined" style="font-size: 1.1rem; color: var(--tertiary);">credit_card</span>
                                <span>@(string.IsNullOrEmpty(Model.DrivingLicenseNumber) ? "Not provided" : Model.DrivingLicenseNumber)</span>
                            </div>
                        </div>
                    </div>

                    <div class="col-12">
                        <div class="p-3 rounded-3 d-flex align-items-center justify-content-between" style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25);">
                            <div class="d-flex align-items-center gap-3">
                                <span class="material-symbols-outlined text-success" style="font-size: 1.5rem;">verified_user</span>
                                <div>
                                    <div class="fw-bold text-white" style="font-size: 0.9375rem;">Account Verification</div>
                                    <div class="text-muted small">Status: @Model.VerificationStatus</div>
                                </div>
                            </div>
                            <span class="badge @(Model.VerificationStatus == VerificationStatus.Verified ? "bg-success" : "bg-warning text-dark") px-2 py-1 rounded-pill small">
                                @Model.VerificationStatus
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Navigation to My Bookings & Signout -->
                <div class="d-flex flex-wrap justify-content-between align-items-center mt-4 pt-3 border-top position-relative gap-2" style="z-index: 2; border-color: var(--border-subtle) !important;">
                    <a asp-controller="Account" asp-action="Bookings" class="btn-primary-gradient py-2 px-3 small">
                        <span class="material-symbols-outlined">event_note</span>
                        <span>My Bookings</span>
                    </a>

                    <div class="d-flex gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn-ghost-dark py-2 px-3 small">
                            <span class="material-symbols-outlined">arrow_back</span>
                            <span>Fleet</span>
                        </a>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger rounded-pill px-3 py-2 small fw-semibold d-inline-flex align-items-center gap-1">
                                <span class="material-symbols-outlined" style="font-size: 1rem;">logout</span>
                                <span>Sign Out</span>
                            </button>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
